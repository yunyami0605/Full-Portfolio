{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".", // 🔹 alias, paths 기준
    "paths": {
      "@my/ui": ["packages/ui/src"],
      "@my/hooks": ["packages/hooks/src"],
      "*": ["types/*"]
    }
  }
}
