{
  "name": "monorepo",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/config/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "feat:fit": "sh shell-script/create-feature.sh ai-hellofit-frontend",
    "test:fit": "yarn workspace ai-hellofit-frontend test",
    "dev:diary": "yarn workspace ai-diary dev",
    "dev:shop": "yarn workspace ai-img-shop dev",
    "dev:fit": "yarn workspace ai-hellofit-frontend dev",
    "lint:diary": "yarn workspace ai-diary lint",
    "lint:shop": "yarn workspace ai-img-shop lint",
    "lint:fit": "yarn workspace ai-hellofit-frontend lint",
    "build:diary": "yarn workspace ai-diary build",
    "build:shop": "yarn workspace ai-img-shop build",
    "build:fit": "yarn workspace ai-hellofit-frontend build"
  },
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "@my-config/eslint": "workspace:^",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.3.5",
    "eslint-config-prettier": "^10.1.5",
    "i": "^0.3.7",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "npm": "^11.5.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "zod": "^4.0.8",
    "zustand": "^5.0.7"
  }
}
